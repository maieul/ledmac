\section{with endnumbering and beginnumbering}
\renewcommand{\memorybreak}{\endnumbering\beginnumbering}
\beginnumbering
\pstart
aa bb %
\edtext{\sameword[1]{cc}}{%
  \Aendnote{EB 1}} dd aa bb \sameword{cc} dd
\pend\memorybreak
\pstart
aa bb %
  dd aa bb \sameword{cc} dd
  \edtext{\sameword[1]{cc}}{%
    \Aendnote{EB 2}}
\pend\memorybreak
\pstart
aa bb %
\edtext{\sameword[1]{cc}}{%
  \Aendnote{EB 3}} dd aa bb \sameword{cc} dd
\pend\memorybreak
\pstart
aa bb %
\sameword{dd}
\sameword{dd} aa bb \sameword{cc} dd
  \edtext{\sameword[1]{dd}}{%
    \Aendnote{EB4}}
\pend
\endnumbering

\doendnotes{A}


