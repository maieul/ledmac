\section{With pausenumbering and resumenumbering}
\beginnumbering
\pstart
aa bb %
\edtext{\sameword[1]{cc}}{%
  \Aendnote{PR 1}} dd aa bb \sameword{cc} dd
\pend\memorybreak
\pstart
aa bb %
  dd aa bb \sameword{cc} dd
  \edtext{\sameword[1]{cc}}{%
    \Aendnote{PR 2}}
\pend\memorybreak
\pstart
aa bb %
\edtext{\sameword[1]{cc}}{%
  \Aendnote{PR 3}} dd aa bb \sameword{cc} dd
\pend\memorybreak
\pstart
aa bb %
  dd aa bb \sameword{cc} dd
  \edtext{\sameword[1]{cc}}{%
    \Aendnote{PR 4}}
\pend
\endnumbering

\doendnotes{A}

